#!/bin/bash
# Apply aria2c downloader for pacman/paru.
# /etc/pacman.conf is NOT git-tracked, so run this after a fresh install:
#   sudo ~/.local/bin/apply-pacman-wget
# AUR source downloads use ~/.config/pacman/makepkg.conf, which is tracked in git.
set -euo pipefail
CONF=/etc/pacman.conf
WRAPPER=/usr/local/bin/pacman-aria2
ARIA2_LINE="XferCommand = $WRAPPER '%u' '%o'"

# Pacman's download sandbox may not be able to execute helpers from /home.
install -Dm755 /home/ayu/.local/bin/pacman-aria2 "$WRAPPER"

# Three package downloads concurrently; aria2c uses five connections per file.
grep -q '^ParallelDownloads' "$CONF" \
  && sed -i 's/^ParallelDownloads.*/ParallelDownloads = 3/' "$CONF" \
  || sed -i '/^\[options\]/a ParallelDownloads = 3' "$CONF"

# Replace stale external downloader entries with one corrected aria2c command.
sed -i '/^XferCommand[[:space:]]*=/d' "$CONF"
sed -i "/^\[options\]/a $ARIA2_LINE" "$CONF"

grep -n '^ParallelDownloads\|^XferCommand' "$CONF"
