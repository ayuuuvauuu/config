#!/bin/bash
# Pacman XferCommand wrapper: keep aria2c's output directory handling correct.
set -euo pipefail

if (( $# != 2 )); then
  echo "usage: pacman-aria2 URL OUTPUT" >&2
  exit 2
fi

url=$1
output=$2
output_dir=${output%/*}
output_file=${output##*/}

if [[ "$output_dir" == "$output" ]]; then
  output_dir=.
fi

display_file=${output_file%.part}
printf 'aria2c: %s\n' "$display_file"

common_args=(
  --continue=true
  --max-tries=3
  --retry-wait=2
  --timeout=20
  --connect-timeout=20
  --file-allocation=none
  --human-readable=true
  --enable-color=true
  --show-console-readout=true
  --console-log-level=error
  --summary-interval=0
  --download-result=hide
  --dir "$output_dir"
  --out "$output_file"
  "$url"
)

if /usr/bin/aria2c \
  --continue=true \
  --split=5 \
  --max-connection-per-server=5 \
  "${common_args[@]}"; then
  exit 0
fi
status=$?

# Some mirrors ignore HTTP range requests. Retry that file without splitting.
if (( status == 8 )); then
  printf 'aria2c: range requests failed; retrying %s with one connection\n' "$display_file" >&2
  rm -f -- "$output" "$output.aria2"
  exec /usr/bin/aria2c --split=1 --max-connection-per-server=1 "${common_args[@]}"
fi

exit "$status"
